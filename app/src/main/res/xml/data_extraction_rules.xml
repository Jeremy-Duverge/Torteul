<?xml version="1.0" encoding="utf-8"?>
<!-- Only the subscriptions file leaves the device (encrypted); the database is rebuilt from it. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="subscriptions.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="subscriptions.json" />
    </device-transfer>
</data-extraction-rules>